{
    "manifest_version": 3,
    "name": "Better Jira",
    "description": "Colorizes tickets and deletes AI useless stuff",
    "version": "2.2",
    "permissions": [
        "storage",
		"activeTab"
    ],
    "icons": {
        "32": "icon.png",
        "64": "icon.png",
        "128": "icon.png",
        "256": "icon.png",
        "512": "icon.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "better-jira@merissler.github.io",
            "strict_min_version": "109.0"
        }
    },
    "content_scripts": [
        {
            "js": [
                "better-jira.js"
            ],
            "matches": [
                "https://*.atlassian.net/*"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "32": "icon.png",
            "64": "icon.png",
            "128": "icon.png",
            "256": "icon.png",
            "512": "icon.png"
        }
    }
}